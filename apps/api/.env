NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL="file:./dev.db"
JWT_SECRET=dev-only-secret-please-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PHOTOS_PER_OBSERVATION=9
STRIP_GPS_DEFAULT=true
